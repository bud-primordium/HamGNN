#: 94a5b5539990400cb43fdeaae1a19c52
msgid "层定义"
msgstr "Layer Definitions"

#: 24f35cfe19184a53b17c444632d6fd43
msgid "一个包含线性层、批量归一化和激活函数的残差连接稠密层。"
msgstr "A residual-connected dense layer that includes linear layers, batch normalization, and an activation function."

#: 1573e910bd574e909800884f8fbda2b6
msgid "结构为: `out = Linear(Act(BN(Linear(x))))`"
msgstr "The structure is: `out = Linear(Act(BN(Linear(x))))`"

#: 0715a564308d4d979aa54b8aa69c0c93 39c9fab71b4545218fdb36d2d024294c
#: 50eb08d349f6406a950ba65d5b8d55a9 aa4ede6efa784c268bc4a7bebfd88a05
#: e6400ad1e8924b80a2f363bccfd02cde fa16f3af962045ffa8b4486cf4669ab8
msgid "前向传播。"
msgstr "Forward propagation."

#: 6f471c61da72410499981622dd31a9af
msgid "一个用于回归任务的多层稠密网络。"
msgstr "A multi-layer dense network for regression tasks."

#: abc5607b9a73479db74759783725c190
msgid "包含多个隐藏层和一个最终的线性输出层。"
msgstr "Consists of multiple hidden layers and a final linear output layer."

#: 6b8275251a7c40c0ad985b5343e47945
msgid "多项式形式的截断包络函数。"
msgstr "A polynomial cutoff envelope function."

#: 20711464cd5c4471914123649e7dce5d
msgid "当距离 `x` 接近 `cutoff` 时，该函数平滑地衰减到零。"
msgstr "This function smoothly decays to zero as the distance `x` approaches the `cutoff`."

#: 5bdf5f906c3a438bb89c6ee7e2bece18
msgid "Behler-Parrinello 余弦截断函数。源自 SchNetPack。"
msgstr "Behler-Parrinello cosine cutoff function. From SchNetPack."

#: 1764ba4ed95a4c60b3adaa170827b5dc
msgid ""
"f(r) = \\begin{cases}\n"
" 0.5 \\times \\left[1 + \\cos\\left(\\frac{\\pi "
"r}{r_\\text{cutoff}}\\right)\\right]\n"
"   & r < r_\\text{cutoff} \\\\\n"
" 0 & r \\geqslant r_\\text{cutoff} \\\\\n"
" \\end{cases}\n"
"\n"
msgstr ""
"f(r) = \\begin{cases}\n"
" 0.5 \\times \\left[1 + \\cos\\left(\\frac{\\pi "
"r}{r_\\text{cutoff}}\\right)\\right]\n"
"   & r < r_\\text{cutoff} \\\\\n"
" 0 & r \\geqslant r_\\text{cutoff} \\\\\n"
" \\end{cases}\n"
"\n"

#: 352df82e11fe458ea0ba5f1f85408f96 6f02a71bf8a04a54b1c7b2949867c029
#: 7ba7197598e840dc93fa147666c4ad33 db42086782fe4015aeb47a604b9f5786
#: f7353b9dc7804c95a374db155d86fb09 f8488d48469a4a958587ff020a9a7adc
msgid "参数"
msgstr "Args"

#: 525c07ac245041c6b05c49077e76fbc7
msgid "截断半径。"
msgstr "Cutoff radius."

#: 8d9a200fe22d46a388b6dbfdaf334641
msgid "计算截断值。"
msgstr "Computes cutoff values."

#: 25d9036254df4323a1b49f89b596edaa
msgid "原子间距离张量。"
msgstr "Tensor of interatomic distances."

#: 7022ebcc69cd4b67a08cf347c820fc1e 7dec47ad9bfb4cd684685e0f827de42a
#: b76a80a227044a708f5abcf031ea136b fe8f664637bb4b478e493fcd366163d7
msgid "返回"
msgstr "Returns"

#: a75f26c53eb045c08d7d93e0b0124229
msgid "截断函数的值。"
msgstr "Value of the cutoff function."

#: 432cf40fc8bc4a23b577e7a9b1aa7600 d181e3b17c214447839cff6feb17215e
#: dfcf935cc9dd49278ce0c50710f3ccf1 e552a843c48c406dbb2683b1603eb3e6
msgid "返回类型"
msgstr "Return type"

#: dab3896418b24891ac7afd7f3065a8bb
msgid "一个多层感知机（MLP）回归网络，特征维度在层间减半。"
msgstr "A Multi-Layer Perceptron (MLP) regression network where the feature dimension is halved between layers."

#: 54c072ff89064dfcbcb3597f1dd46ac9
msgid "计算实数球谐函数的层。"
msgstr "A layer for computing real spherical harmonics."

#: 5626c142d90240d682d66dde30a8ef23
msgid "极角 theta。"
msgstr "The polar angle theta."

#: 3cc425c661ba44c19b20e487afa3d664
msgid "拼接后的球谐函数值。"
msgstr "Concatenated spherical harmonic values."

#: 0ec4d45a16be48f6910a62390455c600
msgid "零阶贝塞尔函数作为径向基函数（来自 DimeNet）。"
msgstr "Zeroth-order Bessel functions as radial basis functions (from DimeNet)."

#: 480a969d0fc647dea54860f11ad21a86
msgid "计算原子间距离的零阶贝塞尔展开。"
msgstr "Computes the zeroth-order Bessel expansion of interatomic distances."

#: f8474ae58aea4fa49b7e3055e1879569
msgid "形状为 (N_edge,) 的原子间距离。"
msgstr "Interatomic distances of shape (N_edge,)."

#: 072301298f304d0998c3a7f92f9a01c9
msgid "形状为 (N_edge, n_rbf) 的零阶贝塞尔展开。"
msgstr "Zeroth-order Bessel expansion of shape (N_edge, n_rbf)."

#: d1ebcd5f7fd34c31a77691bddff75543
msgid "高斯函数作为径向基函数。"
msgstr "Gaussian functions as radial basis functions."

#: 0e13e2a8d75e4fe6a7cae185d7a35cac
msgid "源自 SchNetPack 的全连接线性层，带有激活函数。"
msgstr "Fully connected linear layer with activation function, from SchNetPack."

#: 43db9fd0d943400c9e21b5da418bf9dd
msgid ""
"y = activation(xW^T + b)\n"
"\n"
msgstr ""
"y = activation(xW^T + b)\n"
"\n"

#: 457b86e9f4c34aa2a2f2144903cca10e
msgid "输入特征数 :math:`x`。"
msgstr "Number of input features :math:`x`."

#: 36c167c5197b4b66b900119b5c948493
msgid "输出特征数 :math:`y`。"
msgstr "Number of output features :math:`y`."

#: ab4a5c9360154e89b06b40b0b6fba21d
msgid "如果为 False, 层将不学习偏置 :math:`b`。"
msgstr "If False, the layer will not learn a bias :math:`b`."

#: 02d2b7c050b74e72bff6ad441a321f60
msgid "如果为 None, 则不使用激活函数。"
msgstr "If None, no activation function is used."

#: 1148eca5f5614be78b77c8baac3fc272
msgid "权重的初始化函数。"
msgstr "Initialization function for the weights."

#: 67d65ad6117743d7931fbf6707489b87
msgid "偏置的初始化函数。"
msgstr "Initialization function for the bias."

#: 10c562e6c0f04c50a03093c80154337b
msgid "重新初始化模型的权重和偏置值。"
msgstr "Re-initializes the model's weight and bias values."

#: 39932522a7e54804bc296bca4e42d25e
msgid "计算层的输出。"
msgstr "Computes the output of the layer."

#: f80e947fa2fc4a428b50480724b77fa6
msgid "输入值的批次。"
msgstr "A batch of input values."

#: 712bd95e9f8e4dd398c4c3fab5c08e06
msgid "层的输出。"
msgstr "The output of the layer."