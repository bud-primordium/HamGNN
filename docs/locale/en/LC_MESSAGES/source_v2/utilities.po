#: 138362d56b7b493597c27de8cc542538
msgid "根据条件张量中的值是否超过阈值，从源张量中提取元素。"
msgstr "Extracts elements from a source tensor based on whether values in a condition tensor exceed a threshold."

#: 46d931c097034bec8a1566ce5c7f164f
msgid "用于与阈值比较的张量，形状为 `[N_batch, N, N]`。"
msgstr "The tensor used for comparison with the threshold, with shape `[N_batch, N, N]`."

#: 36aff040fd90418f8d0e63001e881819
msgid "从中提取值的源张量，形状为 `[N_batch, N, N]`。"
msgstr "The source tensor from which values are extracted, with shape `[N_batch, N, N]`."

#: 0ee17fe9bd254741a49d10698b076176
msgid "`condition_tensor` 中元素的最小阈值，超过该值则触发提取。"
msgstr "The minimum threshold for elements in `condition_tensor` that triggers extraction."

#: d43d42ac51e34a40a0455e8eef54092e
msgid "从 `source_tensor` 中提取的一维值张量。"
msgstr "A 1D tensor of values extracted from `source_tensor`."

