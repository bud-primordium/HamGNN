#: 4e46760f29c9438fb61b52106f7cc419
msgid "配置解析"
msgstr "Configuration Parsing"

#: 9a95a13a76644b5887fd3db21cc182a5
msgid "从 YAML 文件读取配置，并与默认配置合并。"
msgstr "Reads configuration from a YAML file and merges it with the default configuration."

#: 3b867cf771d94d81812d6ff913a827ec
msgid "参数"
msgstr "Parameters"

#: 223c21a1a06b414a8f2677eb9bc15c0f
msgid "用户指定的配置文件路径。默认为 'config_default.yaml'。"
msgstr "Path to the user-specified configuration file. Defaults to 'config_default.yaml'."

#: 894e2129bcaf48c2ab6ab48f42616d22
msgid "包含所有默认参数的字典。默认为本模块中定义的 `config_default`。"
msgstr "A dictionary containing all default parameters. Defaults to `config_default` defined in this module."

#: 1c57cd5cfe554eb3804c5d5f4f4fffdf
msgid "返回"
msgstr "Returns"

#: 39f9b8a46113491895c4362f6502790b
msgid "一个 EasyDict 对象，包含了合并后的最终配置，可以通过属性点号 `.` 方便地访问各级配置项。"
msgstr "An EasyDict object containing the merged final configuration, allowing convenient access to nested configuration items using dot notation."

#: a733bf2fc68745089bc82ff6a6c510dd
msgid "返回类型"
msgstr "Return type"

