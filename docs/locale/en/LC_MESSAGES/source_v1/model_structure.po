#: a2c0b38247db4a7c82a7fefd74cabd76 a9cb5e16011b429aa55eb4a57644fcc3
#: ee44b75c0dff43c29fe8aed22f21411f f9094d4a446f4237a2100e0f9b493333
msgid "返回"
msgstr "Returns"

#: e9a5416c73ef4144b5a02ebbef9e115b
msgid "计算得到的加权总损失。"
msgstr "The calculated weighted total loss."

#: 7b95b89a33fd4422894f9b95013bcbea 7edc1e19b1494db4b32b787d70abec73
#: 9144b05018e240749e8d719bf4f1aa39 a0d16bfe67a841eda714281e0e11d6d1
#: a73865155bb2418f958343225bb1a20d fa6175101dc34d649275f0a583cf0029
