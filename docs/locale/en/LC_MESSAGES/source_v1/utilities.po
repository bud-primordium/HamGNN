#: 32a3e41a05ed4d98ac5b1e9af3717689 76fc1149d2da498bb28540289fe2a403
#: 7cd458138aef48b8ae03c108d30c89de b08d9b26f88b4ff7be279007114b0b21
msgid "Should be overridden by all subclasses."
msgstr "Should be overridden by all subclasses."

#: 8ccc14791466474287d8f95538de0050 b2a587e63d9c4709b0686c9a7aaefdc9
#: cebc89c8144846b9a988d78f12bfddec d5711bf702f448ad99b9b17022d99e25
#: e96c4f31bbd74d8389c47da8a35569f7 ec84035ce4344b27a5f50d387c4c15d2
msgid ""
"Although the recipe for forward pass needs to be defined within this "
"function, one should call the :class:`Module` instance afterwards instead"
" of this since the former takes care of running the registered hooks "
"while the latter silently ignores them."
msgstr ""
"Although the recipe for forward pass needs to be defined within this "
"function, one should call the :class:`Module` instance afterwards instead"
" of this since the former takes care of running the registered hooks "
"while the latter silently ignores them."

#: 82fc864063e540c9ab3882fcc01ca025
msgid "Set the extra representation of the module."
msgstr "Set the extra representation of the module."

#: b83d9f23c2514aa294e9eae0e637ce18
msgid ""
"To print customized extra information, you should re-implement this "
"method in your own modules. Both single-line and multi-line strings are "
"acceptable."
msgstr ""
"To print customized extra information, you should re-implement this "
"method in your own modules. Both single-line and multi-line strings are "
"acceptable."

#: f892e56aa78644febe8c5d92e9fc1e0b
msgid "SWISH 激活函数模块"
msgstr "SWISH activation function module"

#: a058b250e37948aab3582aefe354fbbc
msgid "根据字符串名称返回对应的激活函数实例。"
msgstr "Returns the corresponding activation function instance based on the string name."

#: d4dfc6377b024dc1a605aace3455c18c
msgid "激活函数的名称，支持带有参数，如 \"elu(1.0)\"。"
msgstr "The name of the activation function, supports parameters, e.g., \"elu(1.0)\"."

#: 2c69c7d50edd447c8b40e28c62064e6a
msgid "激活函数模块的实例。"
msgstr "An instance of the activation function module."

#: 86ba37640f014c9ab22dc3cd0a384f5c
msgid "抛出"
msgstr "Raises"

#: 64ca80c1f9d3416380357af21e9c1c0c
msgid "如果输入的名称不被支持。"
msgstr "If the input name is not supported."

#: a56a0ffd1e33403ebd6cdcc4d4ed15e7
msgid "绘制预测值与目标值的散点图。"
msgstr "Plots a scatter plot of predicted vs. target values."

#: 31619aad6ae742a697a90b0fa33b40f1
msgid "预测值数组。"
msgstr "Array of predicted values."

#: 5a4915577ec74229949297e0df5e03b3
msgid "目标值数组。"
msgstr "Array of target values."

#: 1b2bea47cd2b42859d88ab5bd4c8a2ef
msgid "绘制好的图表对象。"
msgstr "The plotted chart object."

#: 6ca779c86df743a7a360c42b472a2ccf
msgid "计算 1 - 余弦相似度的损失函数。"
msgstr "Loss function for 1 - cosine similarity."

#: f08df096aafa4703aa30838558dd3b85
msgid "计算预测值总和的 L2 范数，用于约束总和为零。"
msgstr "Calculates the L2 norm of the sum of predictions to constrain the sum to zero."

#: c58ee2b7bf1441fab790d0dc105e4346
msgid "计算预测值和目标值之间的平均欧几里得距离。"
msgstr "Calculates the mean Euclidean distance between predicted and target values."

#: 3248b7cc796742fcb34854d6bf0191b5
msgid "均方根误差损失。"
msgstr "Root Mean Squared Error loss."

#: d312bf69f46c4352a2fab2787d39e5fa
msgid "解析配置文件中的度量函数列表，将字符串名称转换为函数实例。"
msgstr "Parses the list of metric functions in the configuration file, converting string names to function instances."

#: 186c528801d948cda87a0923869aa881
msgid "包含度量函数配置的列表。"
msgstr "A list containing metric function configurations."

#: 6fb18ae94ee34e03852d1dc13b30168f
msgid "更新后的列表，其中 'metric' 的值被替换为函数实例。"
msgstr "The updated list where the value of 'metric' is replaced with a function instance."

#: 6f4c88c27c5b49c9a94b231827bcc096
msgid "根据配置文件提取并组织用于日志记录的超参数字典。"
msgstr "Extracts and organizes a dictionary of hyperparameters for logging based on the configuration file."

#: 6523bbac60b54d8ca0595485a42dea09
msgid "项目的全局配置对象。"
msgstr "The project's global configuration object."

#: 36fb944143a44872ab3a2c9179e3ad0d
msgid "包含 GNN 名称和相关超参数的字典。"
msgstr "A dictionary containing the GNN name and related hyperparameters."

#: 76f5a98ab8c2426584645d6a9d6b0740
msgid "计算图中的所有三元组 (i, j, k)，其中 j 是中心原子。"
msgstr "Computes all triplets (i, j, k) in the graph, where j is the central atom."

#: c1dbfca4107149d39cc14d0c331c89c0
msgid "边索引，形状为 [2, N_edges]。"
msgstr "Edge index, with shape [2, N_edges]."

#: ef5333e3f43c4996808be4daa243363f
msgid "边的周期性偏移向量。"
msgstr "Periodic offset vector of the edges."

#: 25d7a192822b40d9b4492bf9c347a384
msgid "每个节点的近邻数量。"
msgstr "Number of neighbors for each node."

#: bf7ed304aa5747328c3e6ebc5a6fadce
msgid "包含三元组信息的元组 (col_i, row_j, idx_i, idx_j, idx_k, idx_kj, idx_ji)。"
msgstr "A tuple containing triplet information (col_i, row_j, idx_i, idx_j, idx_k, idx_kj, idx_ji)."

