#: f3424644cf3e462f8d97e1a9010d455d
msgid "权重张量。"
msgstr "Weight tensor."

#: fc93b45d6a6840169203641239c2b7f8
msgid "变换后的输出张量。"
msgstr "The transformed output tensor."

#: 46252127cf114d9e87e3e247ee609195
msgid "一个应用带截断(cutoff)的软单位阶跃函数的模块。"
msgstr "A module that applies a soft unit step function with a cutoff."

#: c5f3e888e8c94a5dba7aa47ab49346fb
msgid "该函数在接近截断半径时平滑地将值过渡到零。"
msgstr "This function smoothly transitions values to zero as they approach the cutoff radius."

#: 4a5ab8ff47644fa0b2cfed3107643953
msgid "应用截断的距离。"
msgstr "The distance at which to apply the cutoff."

#: a0fd445fe4734851b429a95ebb85d907
msgid "float"
msgstr "float"

#: ae226e2bc02a4299a63e4e44e8922242
msgid "影响阶跃函数平滑度的可学习参数。"
msgstr "A learnable parameter that affects the smoothness of the step function."

#: 83daca5ec10c4a548cf20eb68008d039
msgid "nn.Parameter"
msgstr "nn.Parameter"

