#: 7cc1dba487e84e56a1135e22d7efe75d
msgid "层定义"
msgstr "Layer Definitions"

#: e2d803f1d78141269d43af5258815879
msgid "一个包含线性层、批量归一化和激活函数的残差连接稠密层。"
msgstr "A residual-connected dense layer containing a linear layer, batch normalization, and an activation function."

#: bf2e1e966b774bac92d682fc9178ac63
msgid "结构为: `out = Linear(Act(BN(Linear(x))))`"
msgstr "Structure: `out = Linear(Act(BN(Linear(x))))`"

#: 130fd3a9f4464b77b128e44bcea30f0e 3a694d77eb534fd7a1ea33dda90d74ec
#: 4964abc3623f4698bac9e5e16b4be9fe 63a638f4cdc24c389b9d7d3737195226
#: a71c1ac61e5446f99866b5433699407c b17bbac20d8b4259bb71c857bd206e41
msgid "前向传播。"
msgstr "Forward propagation."

#: c53a2d3e06ea45bd944b498946366f7a
msgid "一个用于回归任务的多层稠密网络。"
msgstr "A multi-layer dense network for regression tasks."

#: 617b344230f449b2a83568dd1e76d5a4
msgid "包含多个隐藏层和一个最终的线性输出层。"
msgstr "Contains multiple hidden layers and a final linear output layer."

#: 5d46306611634859a86e3dc6a19f7c6e
msgid "多项式形式的截断包络函数。"
msgstr "A cutoff envelope function in polynomial form."

#: 5022f7b1959149c3b44d0dd00cf7d10e
msgid "当距离 `x` 接近 `cutoff` 时，该函数平滑地衰减到零。"
msgstr "This function smoothly decays to zero as the distance `x` approaches the `cutoff`."

#: 3d43f2f7bdf64aeba25ff8cfdc0d1bdd
msgid "Behler-Parrinello 余弦截断函数。源自 SchNetPack。"
msgstr "Behler-Parrinello cosine cutoff function. Sourced from SchNetPack."

#: 8f529518b50743ae85f7126f3b461475
msgid ""
"f(r) = \\begin{cases}\n"
" 0.5 \\times \\left[1 + \\cos\\left(\\frac{\\pi "
"r}{r_\\text{cutoff}}\\right)\\right]\n"
"   & r < r_\\text{cutoff} \\\\\n"
" 0 & r \\geqslant r_\\text{cutoff} \\\\\n"
" \\end{cases}\n"
"\n"
msgstr ""
"f(r) = \\begin{cases}\n"
" 0.5 \\times \\left[1 + \\cos\\left(\\frac{\\pi "
"r}{r_\\text{cutoff}}\\right)\\right]\n"
"   & r < r_\\text{cutoff} \\\\\n"
" 0 & r \\geqslant r_\\text{cutoff} \\\\\n"
" \\end{cases}\n"
"\n"

#: 169700a5d3ca44b282c8462152f48afe 2bfa0d35460e461e9aa8fe5d888c28e8
#: 5144eb5543dc474a8d09b625d4aa51ce c7a609d099b24a098d7c1bfcfd6f5c24
#: dd36b91b3b6e44bbbea211fa4028a3ac e8cb7552636644b6b283a2b6a21d6878
msgid "参数"
msgstr "Args"

#: 35238fb228a44ee48c0699a7c03a6a01
msgid "截断半径。"
msgstr "Cutoff radius."

#: 9a4fd83ed4e04ad48bda810c9680661e
msgid "计算截断值。"
msgstr "Computes the cutoff value."

#: babfc0f7cdc241d2bfdfedb5d65f945c
msgid "原子间距离张量。"
msgstr "Tensor of interatomic distances."

#: 95c38dee1d4d4727a76716b073d6a94b 9cf3387b010d4acab4b5e0165e8ef2fd
#: a676788846a743c4ba61372b522d8331 b31224bff9034337a7ae4e8f0e82806f
msgid "返回"
msgstr "Returns"

#: d73ca902e3ea47cc965c6e0c4d48dec6
msgid "截断函数的值。"
msgstr "The value of the cutoff function."

#: 3acc607a99c5468490fd7a51d1e51cdb 5b4125dc3e1444ba8c3089828425e0e3
#: ec759ffd03ae4aa4a7539e56fb3defda fde3eb6eb87a4bd293b93a38e157db52
msgid "返回类型"
msgstr "Return type"

#: 8391bceb7f9b40989e9c036347873337
msgid "一个多层感知机（MLP）回归网络，特征维度在层间减半。"
msgstr "A multilayer perceptron (MLP) regression network where the feature dimension is halved between layers."

#: 24d5d17c8edc4443ba0f4921ae04538f
msgid "计算实数球谐函数的层。"
msgstr "A layer for computing real spherical harmonics."

#: 8b0d4a1000174cc48212ef15161133d6
msgid "极角 theta。"
msgstr "Polar angle theta."

#: 712f6a0e53f84bf3b6ac92cf6e626a3c
msgid "拼接后的球谐函数值。"
msgstr "Concatenated spherical harmonic values."

#: 0da53494f4924a07a9854688636d69f4
msgid "零阶贝塞尔函数作为径向基函数（来自 DimeNet）。"
msgstr "Zeroth-order Bessel functions as radial basis functions (from DimeNet)."

#: 527b0b0ecda44f4188287c05730c7d42
msgid "计算原子间距离的零阶贝塞尔展开。"
msgstr "Computes the zeroth-order Bessel expansion of interatomic distances."

#: 5e4f0c3aefdd4ac9bb08c4e5b453f585
msgid "形状为 (N_edge,) 的原子间距离。"
msgstr "Interatomic distances with shape (N_edge,)."

#: 5440841f7c0e40a19130e74576a68183
msgid "形状为 (N_edge, n_rbf) 的零阶贝塞尔展开。"
msgstr "Zeroth-order Bessel expansion with shape (N_edge, n_rbf)."

#: ccde9a24620a414b8d0969b723b5bbd0
msgid "高斯函数作为径向基函数。"
msgstr "Gaussian functions as radial basis functions."

#: d9f944e23b334e9e99ebf5b1d0920233
msgid "源自 SchNetPack 的全连接线性层，带有激活函数。"
msgstr "A fully connected linear layer with activation function, sourced from SchNetPack."

#: 5c6bd563281b45af8cfd5e144906d882
msgid ""
"y = activation(xW^T + b)\n"
"\n"
msgstr ""
"y = activation(xW^T + b)\n"
"\n"

#: e45699d43e1347cf8156b5fece79a753
msgid "输入特征数 :math:`x`。"
msgstr "Number of input features :math:`x`."

#: 26a1ae2e60674b4a91b725c2dc329a3e
msgid "输出特征数 :math:`y`。"
msgstr "Number of output features :math:`y`."

#: fa3d5e77e5704cd09263281452350ea6
msgid "如果为 False, 层将不学习偏置 :math:`b`。"
msgstr "If False, the layer will not learn a bias :math:`b`."

#: ea575bc8c1b14b41bb6446b4ffda3a0d
msgid "如果为 None, 则不使用激活函数。"
msgstr "If None, no activation function is used."

#: 5c962f9220664e54a705a402000a772e
msgid "权重的初始化函数。"
msgstr "Initialization function for the weights."

#: ffca5630269c4a97b449a32c51e49a15
msgid "偏置的初始化函数。"
msgstr "Initialization function for the bias."

#: 3173d9a4d5684235a6f86d9fd2877cd6
msgid "重新初始化模型的权重和偏置值。"
msgstr "Re-initializes the model's weights and bias values."

#: 365810a3f5ea476ca3a10e2fe3d500ae
msgid "计算层的输出。"
msgstr "Computes the output of the layer."

#: 311d9c3a026e43d5a7810906a6819acb
msgid "输入值的批次。"
msgstr "Batch of input values."

#: ae0dd4e0c6b6404fb6e1a35cb9f8ae53
msgid "层的输出。"
msgstr "Output of the layer."