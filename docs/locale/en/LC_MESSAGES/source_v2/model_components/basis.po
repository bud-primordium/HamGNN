#: 07c5d9ecfc684a1bbd9141cf0af89036 38a6830f6445499bbaacded9e4b943b0
#: d7cedb40005d4a4195b527f4df71ece7 e36cffe26e8544558af56d442748d98c
msgid "int"
msgstr "int"

#: 58cb292de2844c61a09ee85835f93caf
msgid "截断半径，超出此距离的相互作用将被忽略。"
msgstr "The cutoff radius, beyond which interactions are ignored."

#: 220afee76c2242628e5bdeab7a286aec 2724e49f02c945c4a2898ddf1af98ba5
#: 2df14aec3b104de2abf671c723a9e398 404a0e72a46f425eb1258d6d3b8f5e62
#: 49e087d575d54d66806fd950d3724b59 5d83851038eb42238d7de2995162098e
#: 5da215304258433bb757d08fe2aa093c 7e835fb1245344018d1c0526a386d1a6
